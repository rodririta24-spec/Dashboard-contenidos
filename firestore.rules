rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tablero — solo usuarios autenticados
    match /tablero/{docId} {
      allow read, write: if request.auth != null;
    }

    // Comentarios — solo usuarios autenticados
    match /comments/{docId} {
      allow read, write: if request.auth != null;
    }

    // FCM tokens — cualquier dispositivo puede registrar su token
    match /fcmTokens/{tokenId} {
      allow write: if true;
      allow read: if false; // solo la Cloud Function (Admin SDK) lee
    }

    // Config (API URL para la Cloud Function) — solo autenticados pueden escribir
    match /config/{docId} {
      allow write: if request.auth != null;
      allow read: if false; // solo la Cloud Function (Admin SDK) lee
    }

    // Editors whitelist — cualquier usuario autenticado puede leer su propio doc
    match /editors/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
    }
  }
}
